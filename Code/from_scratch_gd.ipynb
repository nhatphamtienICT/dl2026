   "source": [
    "\n",
    "def func(x):\n",
    "    return x*x;\n",
    "\n",
    "def derivative(x):\n",
    "    return 2*x\n",
    "\n",
    "def gd(start, lr, iter):\n",
    "    x = start;\n",
    "    for i in range(iter):\n",
    "        x = x - lr * derivative(x) \n",
    "        print(f\"Iteration {i+1}: x = {x:.4f}, f(x) = {func(x):.4f}\")\n",
    "    return x\n",
    "\n",
    "gd(10, 0.0000001, 10)\n",
    "\n"
   ]
  }
 ],
